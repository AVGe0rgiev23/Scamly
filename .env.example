# Example environment variables for Scamly.
#
# Copy this file to .env.local (`cp .env.example .env.local`) and fill in your own values.
# .env.local is ignored by git: NEVER commit real keys or passwords.
# This file only lists the names, with no real values.
# src/lib/env.ts checks these variables when the server needs them.

# --- Supabase (database, login, realtime) --------------------------------------------
# Project URL from Supabase → Project Settings → API. Locally: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Public key: the "publishable" key (sb_publishable_…; older projects: the "anon" key).
# Safe to send to the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…; older projects: the "service_role" key): bypasses RLS.
# Server only, used in a short list of functions (src/server/supabase/adminClient.ts). SECRET.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secret peppers for hashing (at least 32 characters each) ------------------------
# Generate each one with: openssl rand -hex 32
# Mixed into the hash of device pairing codes. SECRET.
PAIRING_PEPPER=
# Mixed into the hash of phone numbers and other personal data. SECRET.
HASH_PEPPER=

# --- E-mail alerts --------------------------------------------------------------------
# Which service sends e-mails: brevo | resend | noop (noop = send nothing, for local work).
EMAIL_PROVIDER=noop
# API key from Brevo → SMTP & API → API Keys. Needed only when EMAIL_PROVIDER=brevo. SECRET.
BREVO_API_KEY=
# The verified sender address, e.g. alerts@example.com
EMAIL_FROM=
# The site's public address for the links in alert e-mails, e.g. https://scamly.vercel.app
# Optional: on Vercel the production address is used automatically
# (VERCEL_PROJECT_PRODUCTION_URL); locally the default is http://localhost:3000.
SITE_URL=

# --- Web push notifications -----------------------------------------------------------
# A key pair we generate once with: npx web-push generate-vapid-keys
# Without both keys, push is simply off (the live page and e-mail still work).
# Public key: the browser uses it to subscribe (it gets it from GET /api/push/public-key).
VAPID_PUBLIC_KEY=
# Private key: signs our push messages. SECRET.
VAPID_PRIVATE_KEY=
# Our contact address for the push services, "mailto:…" or "https://…".
# Optional: default mailto:scamly-demo@example.invalid (set a real one on Vercel).
VAPID_SUBJECT=

# --- AI second opinion (optional feature, Week 3) -------------------------------------
# Free key from Google AI Studio. SECRET.
GEMINI_API_KEY=
# Free key from the Groq console (backup AI provider). SECRET.
GROQ_API_KEY=

# --- Scheduled jobs -------------------------------------------------------------------
# Shared secret that scheduled (cron) requests must send to our API. SECRET.
CRON_SECRET=

# --- Feature switches (see src/config/features.ts) -------------------------------------
# "true" or "1" = on, anything else = off. Leave empty to use the default shown.
# AI second opinion (default: off)
FEATURE_AI=
# Voice input on the protected person's phone (default: on)
FEATURE_VOICE=
# Escalate an unanswered alert to more family members (default: off)
FEATURE_ESCALATION=
# Web push notifications (default: on)
FEATURE_PUSH=
# Alert e-mails (default: on)
FEATURE_EMAIL=

# --- Demo seed (local only, never needed by the deployed app) --------------------------
# Set only for an approved empty demo database. Secret shared by the fictional human
# demo accounts. Choose 12–72 characters; never commit a real value or share it in chat.
SEED_DEMO_PASSWORD=
